---
source: crates/loom-config/tests/templates.rs
expression: "AgentConfig::default().to_yaml()"
---
version: 1
allowed_roots:
- "~"
relay:
  enabled: false
socket: {}
storage: {}
lifecycle: {}
instructions:
  max_bytes: 64KiB
llm:
  providers: {}
tools:
  read:
    max_lines: 2000
    max_bytes: 50KiB
  shell:
    program: /bin/bash
    max_lines: 2000
    max_bytes: 50KiB
    pty: false
  web_search:
    model: gpt-5.6-luna
    max_sources: 5
    max_allowed_sources: 10
    timeout: 2m
  notes:
    max_bytes: 64KiB
  tasks:
    max_items: 100
terminal:
  detached_timeout: 10m
policy:
  default: ask
  rules:
  - tool: read
    action: allow
sandbox:
  backend: none
  network: true
  writable: []
  max_output: 1MiB
context:
  max_tool_output_tokens: 8000
  compaction_threshold: 0.8
logging:
  level: info
telemetry:
  enabled: false
  metrics: true
  logs: true
  metrics_interval: 1m
  logs_interval: 5s
  temporality: cumulative
  prefix: loom
  service_name: loom-agent
  log_user_prompts: false
  log_assistant_responses: false
  log_tool_details: false
  content_max_length: 61440
